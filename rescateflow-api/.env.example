# Puerto HTTP de la API
PUERTO=3000

# Ruta del archivo SQLite (se crea automaticamente)
RUTA_BASE_DATOS=./data/rescateflow.db

# Proveedor de geocodificacion: SIMULADO (sin internet) o NOMINATIM (OpenStreetMap)
GEOCODIFICACION_PROVEEDOR=SIMULADO

# Area de cobertura (perimetro urbano de Pasto): latMin,lonMin,latMax,lonMax
AREA_COBERTURA=1.1500,-77.3300,1.2600,-77.2300

# Velocidad promedio para estimar tiempo de llegada (km/h)
VELOCIDAD_PROMEDIO_KMH=30

# Origen permitido para CORS (frontend React + Vite)
CORS_ORIGEN=http://localhost:5173
